{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RealmKeeper",
  "version": "0.3.3",
  "identifier": "io.github.realmkeeper.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RealmKeeper",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 760,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0d0a07"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../catalog/": "catalog/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
