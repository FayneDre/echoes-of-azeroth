{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes-of-azeroth.github.io/schema/v1/client.schema.json",
  "title": "Game client manifest",
  "description": "Describes a game client version the launcher can detect, configure and start. The client itself is always provided by the user and never distributed. Lives at catalog/clients/<id>.json.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "game",
    "version",
    "build",
    "detection",
    "locales",
    "realmlist",
    "patches",
    "serverData",
    "branding"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "branding": {
      "description": "How the launcher presents this client (side bar, accent colour). Emblems are original artwork shipped with the launcher, never Blizzard logos (principle 7).",
      "type": "object",
      "required": ["shortName", "emblem", "accent"],
      "properties": {
        "shortName": {
          "description": "Expansion name shown next to the emblem.",
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "emblem": {
          "description": "Id of an emblem bundled with the launcher (app/src/lib/emblems). Unknown ids fall back to a generic emblem.",
          "$ref": "common.schema.json#/$defs/id"
        },
        "accent": {
          "description": "Accent colour of the expansion, as #rrggbb.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      },
      "additionalProperties": false
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "game": {
      "enum": [
        "wow"
      ]
    },
    "version": {
      "type": "string"
    },
    "build": {
      "type": "integer",
      "minimum": 1
    },
    "detection": {
      "type": "object",
      "required": [
        "executable",
        "build"
      ],
      "properties": {
        "executable": {
          "description": "Executable relative to the client root.",
          "type": "string"
        },
        "build": {
          "description": "Build number expected in the executable version info.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "locales": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2}[A-Z]{2}$"
      }
    },
    "realmlist": {
      "type": "object",
      "required": [
        "file",
        "line"
      ],
      "properties": {
        "file": {
          "description": "Path template relative to the client root; {locale} is replaced.",
          "type": "string"
        },
        "line": {
          "description": "Line template; {address} is replaced.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "patches": {
      "type": "object",
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "description": "Directory receiving MPQ patches, relative to the client root.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "required": [
        "directory"
      ],
      "properties": {
        "directory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "serverData": {
      "description": "Pre-extracted server data (dbc, maps, vmaps, mmaps) matching this client. Downloaded by the launcher directly from the pinned upstream release and verified by sha256; never re-hosted by this project (ADR 0006).",
      "type": "object",
      "required": [
        "url",
        "version",
        "size",
        "sha256",
        "contents"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "size": {
          "description": "Size in bytes of the download.",
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contents": {
          "description": "Top-level directories expected after extraction.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
