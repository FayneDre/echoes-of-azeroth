{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes-of-azeroth.github.io/schema/v1/component.schema.json",
  "title": "Component manifest",
  "description": "A shared third-party runtime (database server, redistributable...). Lives at catalog/components/<id>.json.",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "kind", "version", "license", "homepage", "platforms"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "kind": { "enum": ["database", "runtime"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "channel": { "description": "Upstream release channel, e.g. 'lts'.", "type": "string" },
    "license": { "$ref": "common.schema.json#/$defs/spdxLicense" },
    "homepage": { "type": "string", "format": "uri" },
    "platforms": {
      "description": "Keyed by '<os>-<arch>' (e.g. 'windows-x86_64'). Other platforms are added later.",
      "type": "object",
      "propertyNames": { "pattern": "^(windows|linux|macos)-(x86_64|aarch64)$" },
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["upstream", "size", "sha256", "executables"],
        "properties": {
          "upstream": {
            "description": "Official download (used by CI to build and smoke-test servers).",
            "type": "string",
            "format": "uri"
          },
          "size": {
            "description": "Exact size of the upstream download in bytes.",
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "description": "sha256 of the upstream download, computed once and cross-checked against the vendor's published checksum. Anything else is rejected.",
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "executables": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
