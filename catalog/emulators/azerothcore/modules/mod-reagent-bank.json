    "fr": "Un PNJ qui garde tes composants d'artisanat sans prendre de place dans tes sacs ni ta banque. Un MJ le place avec .npc add 290011."
  },
  "category": "quality-of-life",
  "homepage": "https://github.com/ZhengPeiRu21/mod-reagent-bank",
  "license": "MIT",
  "source": {
    "repo": "https://github.com/ZhengPeiRu21/mod-reagent-bank",
    "ref": "master",
    "commit": "62c265338ceba10fb754394413e6c4c61cedf9de"
  },
  "compatibleFlavors": [
    "playerbot"
  ],
  "requires": [],
  "conflicts": [],
