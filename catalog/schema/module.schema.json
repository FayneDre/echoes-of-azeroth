{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realmkeeper.github.io/schema/v1/module.schema.json",
  "title": "Module manifest",
  "description": "A server module. All catalog modules are compiled into the 'full build' of a flavor; the launcher installs/removes them by toggling configuration and applying their SQL. Lives at catalog/emulators/<emulator>/modules/<id>.json.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "emulator",
    "name",
    "description",
    "category",
    "homepage",
    "license",
    "source",
    "compatibleFlavors",
    "removable",
    "activation",
    "database",
    "config"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "emulator": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "category": {
      "enum": [
        "bots",
        "economy",
        "progression",
        "gameplay",
        "quality-of-life",
        "cosmetic",
        "administration"
      ]
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "$ref": "common.schema.json#/$defs/spdxLicense"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/gitSource"
    },
    "compatibleFlavors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "removable": {
      "description": "false for modules that cannot be uninstalled once installed (e.g. modules mandated by the flavor).",
      "type": "boolean"
    },
    "activation": {
      "$ref": "#/$defs/activation"
    },
    "database": {
      "$ref": "#/$defs/database"
    },
    "config": {
      "$ref": "#/$defs/config"
    },
    "options": {
      "description": "Simplified settings exposed in the launcher UI. Advanced users can still edit every key.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/option"
      }
    },
    "assets": {
      "description": "Optional packaged files (client MPQ patches, server DBC overrides) built by CI from the module repository.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "postInstall": {
      "description": "Steps run once after the module is first enabled on an instance.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/postInstallStep"
      }
    },
    "spawns": {
      "description": "NPCs the module only defines as templates: the launcher places them at named teleport places while the module is enabled (ADR 0023).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "creature",
          "places"
        ],
        "properties": {
          "creature": {
            "description": "Creature template id defined by the module's SQL.",
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "places": {
            "description": "Teleport place names of the world database (AzerothCore game_tele.name).",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9]{1,64}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "party": {
      "description": "Bot party the launcher can form for a player in the world, through console commands this module provides (ADR 0025).",
      "type": "object",
      "required": [
        "size",
        "commands",
        "classes"
      ],
      "properties": {
        "size": {
          "description": "Characters in a party, the player included.",
          "type": "integer",
          "minimum": 2,
          "maximum": 40
        },
        "commands": {
          "description": "Console command templates. {player}, {class}, {spec} and {level} are replaced by checked values.",
          "type": "object",
          "required": [
            "add",
            "remove",
            "list"
          ],
          "properties": {
            "add": {
              "type": "string",
              "pattern": "^[.][a-z].*[{]player[}].*$"
            },
            "remove": {
              "type": "string",
              "pattern": "^[.][a-z].*[{]player[}].*$"
            },
            "list": {
              "type": "string",
              "pattern": "^[.][a-z].*[{]player[}].*$"
            }
          },
          "additionalProperties": false
        },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "classId",
              "token",
              "name",
              "specs"
            ],
            "properties": {
              "id": {
                "description": "Launcher class id (as in the online character list).",
                "type": "string",
                "pattern": "^[a-z][a-z-]{1,31}$"
              },
              "classId": {
                "description": "The emulator's class number (MEMBER replies).",
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "token": {
                "description": "Class word of the add command.",
                "type": "string",
                "pattern": "^[a-z]{1,32}$"
              },
              "name": {
                "$ref": "common.schema.json#/$defs/localizedText"
              },
              "minLevel": {
                "description": "Lowest level a bot of this class can have.",
                "type": "integer",
                "minimum": 1,
                "maximum": 255
              },
              "specs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "number",
                    "role",
                    "name"
                  ],
                  "properties": {
                    "number": {
                      "description": "Premade spec number of the add command.",
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "role": {
                      "enum": [
                        "tank",
                        "healer",
                        "dps"
                      ]
                    },
                    "name": {
                      "$ref": "common.schema.json#/$defs/localizedText"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "activation": {
      "oneOf": [
        {
          "description": "The module is always active when compiled in (only valid for non-removable modules).",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "always"
            }
          },
          "additionalProperties": false
        },
        {
          "description": "The module is enabled/disabled through config keys. CI must prove that 'disable' makes the module inert.",
          "type": "object",
          "required": [
            "mode",
            "enable",
            "disable"
          ],
          "properties": {
            "mode": {
              "const": "config"
            },
            "enable": {
              "$ref": "#/$defs/configChanges"
            },
            "disable": {
              "$ref": "#/$defs/configChanges"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "configChanges": {
      "description": "Config file -> key -> value.",
      "type": "object",
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/configFilePath"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/configMap"
      }
    },
    "database": {
      "type": "object",
      "required": [
        "dbimportId",
        "touches"
      ],
      "properties": {
        "dbimportId": {
          "description": "Name used in dbimport 'Updates.AllowedModules' to allow this module's SQL.",
          "type": "string",
          "minLength": 1
        },
        "applyWhenDisabled": {
          "description": "true when the module reads its own tables even while disabled (it is compiled in, ADR 0003), so its SQL is applied whether or not it is chosen. Only for SQL that creates and fills the module's own tables, never for SQL that changes game content (ADR 0008).",
          "type": "boolean",
          "default": false
        },
        "touches": {
          "description": "Databases (core or extra) receiving SQL from this module.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "extraDatabases": {
          "description": "Databases owned by this module, created when it is installed.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "playerData",
              "connections"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "name": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "playerData": {
                "type": "boolean"
              },
              "connections": {
                "$ref": "common.schema.json#/$defs/dbConnections"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "description": "Config files owned by the module, rendered from their .conf.dist plus launcher defaults.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "file",
              "dist"
            ],
            "properties": {
              "file": {
                "$ref": "common.schema.json#/$defs/configFilePath"
              },
              "dist": {
                "type": "string",
                "pattern": "\\.conf\\.dist$"
              },
              "defaults": {
                "$ref": "common.schema.json#/$defs/configMap"
              }
            },
            "additionalProperties": false
          }
        },
        "coreOverrides": {
          "description": "Settings the module imposes on core config files while installed. Shown as locked in the UI.",
          "$ref": "#/$defs/configChanges"
        }
      },
      "additionalProperties": false
    },
    "configTarget": {
      "type": "object",
      "required": [
        "file",
        "key"
      ],
      "properties": {
        "file": {
          "$ref": "common.schema.json#/$defs/configFilePath"
        },
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "option": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "label",
            "target",
            "default"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": {
              "const": "boolean"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "help": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "target": {
              "$ref": "#/$defs/configTarget"
            },
            "default": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "label",
            "target",
            "default"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": {
              "const": "integer"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "help": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "target": {
              "$ref": "#/$defs/configTarget"
            },
            "default": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "id",
            "type",
            "label",
            "target",
            "default"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": {
              "const": "number"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "help": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "target": {
              "$ref": "#/$defs/configTarget"
            },
            "default": {
              "type": "number"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "description": "Decimal value (rates: 1 = upstream speed)."
        },
        {
          "description": "Mutually exclusive choice. Each choice may install assets and set config values.",
          "type": "object",
          "required": [
            "id",
            "type",
            "label",
            "choices",
            "default"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "type": {
              "const": "choice"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "help": {
              "$ref": "common.schema.json#/$defs/localizedText"
            },
            "default": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label"
                ],
                "properties": {
                  "id": {
                    "$ref": "common.schema.json#/$defs/id"
                  },
                  "label": {
                    "$ref": "common.schema.json#/$defs/localizedText"
                  },
                  "help": {
                    "$ref": "common.schema.json#/$defs/localizedText"
                  },
                  "assets": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "$ref": "common.schema.json#/$defs/id"
                    }
                  },
                  "config": {
                    "$ref": "#/$defs/configChanges"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "asset": {
      "description": "Files shipped in the module repository (client MPQ patches, server DBC overrides), downloaded from the pinned commit and verified by sha256; never re-hosted (ADR 0006, ADR 0013).",
      "type": "object",
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "source": {
          "description": "An archive (.zip or .7z): a file of the module repository at its pinned commit ('path'), or GitHub's archive of another repository at a pinned commit ('repository' + 'commit').",
          "type": "object",
          "required": [
            "size",
            "sha256"
          ],
          "properties": {
            "path": {
              "description": "Path in the module repository.",
              "allOf": [
                {
                  "$ref": "#/$defs/relativePath"
                },
                {
                  "type": "string",
                  "pattern": "\\.(zip|7z)$"
                }
              ]
            },
            "repository": {
              "description": "Another GitHub repository (https://github.com/<owner>/<repo>); its archive at 'commit' is downloaded.",
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "commit": {
              "description": "Full commit of 'repository'.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false,
          "oneOf": [
            {
              "required": [
                "path"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "repository"
                    ]
                  },
                  {
                    "required": [
                      "commit"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "repository",
                "commit"
              ],
              "not": {
                "required": [
                  "path"
                ]
              }
            }
          ]
        },
        "client": {
          "description": "Archive members copied into the client patch directory (tracked and removable).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetFile"
          }
        },
        "server": {
          "description": "Archive members overlaid on the instance server data directory (e.g. 'dbc/Spell.dbc').",
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetFile"
          }
        },
        "addons": {
          "description": "Archive folders installed as client add-ons ('from' = folder of the archive, 'to' = the add-on folder name), tracked and removable (ADR 0020).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/assetFile"
          }
        }
      },
      "additionalProperties": false
    },
    "assetFile": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "description": "Member of the archive.",
          "$ref": "#/$defs/relativePath"
        },
        "to": {
          "description": "Destination relative to the client patch directory or the server data directory.",
          "$ref": "#/$defs/relativePath"
        }
      },
      "additionalProperties": false
    },
    "relativePath": {
      "description": "Relative path: '/' separators, segments of letters, digits, '.', '_' or '-', never '.' or '..'.",
      "type": "string",
      "pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "postInstallStep": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "step",
            "as",
            "username"
          ],
          "properties": {
            "step": {
              "const": "create-account"
            },
            "as": {
              "description": "Binding name reusable in later steps as ${<as>.id}.",
              "type": "string"
            },
            "username": {
              "type": "string",
              "pattern": "^[A-Z0-9]{3,16}$"
            },
            "gmLevel": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "step",
            "as",
            "account",
            "name"
          ],
          "properties": {
            "step": {
              "const": "create-character"
            },
            "as": {
              "description": "Binding name reusable as ${<as>.guid}.",
              "type": "string"
            },
            "account": {
              "description": "Binding of a previous create-account step.",
              "type": "string"
            },
            "name": {
              "type": "string",
              "pattern": "^[A-Z][a-z]{1,11}$"
            },
            "race": {
              "type": "string"
            },
            "class": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "step",
            "values"
          ],
          "properties": {
            "step": {
              "const": "set-config"
            },
            "values": {
              "$ref": "#/$defs/configChanges"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
