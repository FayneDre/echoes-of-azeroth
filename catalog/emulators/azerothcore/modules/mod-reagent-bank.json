{
  "$schema": "../../../schema/module.schema.json",
  "schemaVersion": 1,
  "id": "mod-reagent-bank",
  "emulator": "azerothcore",
  "name": {
    "en": "Reagent Bank",
    "fr": "Banque de composants"
  },
