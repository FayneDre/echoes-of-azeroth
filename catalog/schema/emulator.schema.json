{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://realmkeeper.github.io/schema/v1/emulator.schema.json",
  "title": "Emulator manifest",
  "description": "Describes an emulator family (e.g. AzerothCore): its driver, client, shared components, databases, processes and ports. Lives at catalog/emulators/<id>/emulator.json.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "homepage",
    "license",
    "driver",
    "client",
    "components",
    "defaultFlavor",
    "databases",
    "ports",
    "processes",
    "instance"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "$ref": "common.schema.json#/$defs/localizedText"
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "$ref": "common.schema.json#/$defs/spdxLicense"
    },
    "driver": {
      "description": "Name of the Rust driver implementing emulator-specific behaviour (accounts, config format, console).",
      "$ref": "common.schema.json#/$defs/id"
    },
    "client": {
      "description": "Id of the client manifest (catalog/clients/<id>.json) this emulator serves.",
      "$ref": "common.schema.json#/$defs/id"
    },
    "components": {
      "description": "Shared components required by every instance (e.g. MySQL).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "additionalProperties": false
      }
    },
    "defaultFlavor": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "databases": {
      "description": "Core databases. Modules may add extra ones.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/database"
      }
    },
    "ports": {
      "description": "Named default ports. The launcher picks free ports at install time and remembers them per instance.",
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "processes": {
      "description": "Server processes, started in array order and stopped in reverse order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/process"
      }
    },
    "instance": {
      "description": "Values the launcher imposes in every instance (ADR 0007): paths, ports, credentials, migration switches. Placeholders: ${dir.instance}, ${dir.logs}, ${dir.sql}, ${dir.data}, ${tool.mysql}, ${port.<name>}, ${network.bind}, ${modules.dbimport}; in 'connection': ${db.port}, ${db.user}, ${db.password}, ${db.name}.",
      "type": "object",
      "required": [
        "connection",
        "config"
      ],
      "properties": {
        "diskSize": {
          "description": "Approximate disk use in bytes of one installed instance (server files, SQL tree, databases), measured on a real install: free-space check before an install, on top of the downloads.",
          "type": "integer",
          "minimum": 1
        },
        "connection": {
          "description": "Template of the value written to every database connection key.",
          "type": "string",
          "minLength": 1
        },
        "config": {
          "description": "Config file (relative to configs/) -> key -> value. A value that is exactly one numeric placeholder is written as a number.",
          "type": "object",
          "additionalProperties": {
            "$ref": "common.schema.json#/$defs/configMap"
          }
        },
        "dbImport": {
          "description": "Tool that applies core and module SQL to the databases after every install or change (AzerothCore dbimport). Without it, the servers migrate their own databases when they start (built-in updater).",
          "type": "object",
          "required": [
            "executable",
            "configFile"
          ],
          "properties": {
            "executable": {
              "description": "Path relative to the instance root.",
              "type": "string",
              "minLength": 1
            },
            "configFile": {
              "$ref": "common.schema.json#/$defs/configFilePath"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "description": "Realm settings shown in the launcher (rates, realm type...), by section. Values are stored under the reserved key 'realm' of the instance options.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "options"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/localizedText"
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "module.schema.json#/$defs/option"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "consoleActions": {
      "description": "Ready-made console commands of the GM panel (ADR 0020).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/consoleAction"
      }
    },
    "experimental": {
      "description": "Not offered to players (ADR 0024): listed and installable only when RK_EXPERIMENTAL=1 (development).",
      "type": "boolean",
      "default": false
    },
    "dataExtraction": {
      "description": "Server data made on the player's machine from their own client by tools of the server build, instead of the client manifest's serverData download (ADR 0024). Each step runs in the output directory; the client folder is only read.",
      "type": "object",
      "required": ["version", "locale", "steps", "contents"],
      "properties": {
        "version": {
          "description": "Format of the extracted files: a new value makes a new folder in the store.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$"
        },
        "locale": {
          "description": "Locale the client must have (the server reads its DBC files).",
          "type": "string",
          "pattern": "^[a-z]{2}[A-Z]{2}$"
        },
        "maxClientPath": {
          "description": "Longest client path the tools accept (fixed-size buffers).",
          "type": "integer",
          "minimum": 8
        },
        "unpackedSize": {
          "description": "Approximate size in bytes of the result (free-space check).",
          "type": "integer",
          "minimum": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/extractionStep" }
        },
        "remove": {
          "description": "Intermediate directories removed once every step is done.",
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "contents": {
          "description": "Top-level directories of the result (what DataDir must hold).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "savePlayers": {
      "description": "Console command that writes every player to the database before a backup taken while the servers run, and the output line that says it is done (ADR 0022).",
      "type": "object",
      "required": [
        "command",
        "done"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "done": {
          "description": "Text of the output line printed once the saves are queued.",
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "description": "Longest wait for `done` before the backup goes ahead anyway (default 30).",
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "settleSeconds": {
          "description": "Extra wait after `done`, for writes the server makes in the background (default 0).",
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "relativePath": {
      "description": "Relative path: '/' separators, segments of letters, digits, '.', '_' or '-', never '.' or '..'.",
      "type": "string",
      "pattern": "^(?!\\.\\.?(/|$))(?!.*/\\.\\.?(/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
    },
    "extractionStep": {
      "type": "object",
      "required": ["id", "executable", "weight", "label"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "executable": {
          "description": "Relative to the instance root (a tool of the server build).",
          "$ref": "#/$defs/relativePath"
        },
        "args": {
          "description": "Arguments; ${client.root}, ${client.data} and ${cpu.count} are replaced. Paths are relative to the output directory.",
          "type": "array",
          "items": { "type": "string" }
        },
        "create": {
          "description": "Directories created in the output before the step runs.",
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" },
          "uniqueItems": true
        },
        "weight": {
          "description": "Share of the whole extraction time (progress bar).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "label": { "$ref": "common.schema.json#/$defs/localizedText" }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "required": [
        "id",
        "name",
        "playerData",
        "connections"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "name": {
          "description": "Default schema name in MySQL.",
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "playerData": {
          "description": "true when the database holds player data (accounts, characters). Such databases are never regenerated, only migrated and backed up.",
          "type": "boolean"
        },
        "connections": {
          "$ref": "common.schema.json#/$defs/dbConnections"
        }
      },
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "executable": {
          "description": "Path relative to the instance root.",
          "type": "string"
        },
        "configFile": {
          "$ref": "common.schema.json#/$defs/configFilePath"
        },
        "readiness": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "port"
              ],
              "properties": {
                "type": {
                  "const": "tcp"
                },
                "port": {
                  "description": "Name of a port declared in 'ports'.",
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "pattern"
              ],
              "properties": {
                "type": {
                  "const": "log-line"
                },
                "pattern": {
                  "description": "Regular expression matched against stdout.",
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "args": {
          "description": "Command-line arguments. The working directory is the instance root.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop": {
          "description": "How the supervisor stops the process cleanly (ADR 0011).",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "description": "Close stdin: the process saves and exits on end of input. Also happens when the launcher dies.",
                  "const": "close-stdin"
                },
                "timeoutSeconds": {
                  "description": "Time the clean shutdown may print nothing before the process is killed (default 300): a shutdown that still logs is never killed.",
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "description": "Kill: only for processes that keep no unsaved state. Killed with the launcher too.",
                  "const": "terminate"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "startup": {
          "description": "Output lines marking how far the start went (start progress bar, ADR 0020), in order.",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "match",
              "progress",
              "label"
            ],
            "properties": {
              "match": {
                "description": "Text an output line contains.",
                "type": "string",
                "minLength": 1
              },
              "progress": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localizedText"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "executable",
        "configFile",
        "readiness",
        "stop"
      ],
      "additionalProperties": false
    },
    "consoleAction": {
      "type": "object",
      "required": [
        "id",
        "label",
        "command"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "command": {
          "description": "The console command, with {param} placeholders.",
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consoleParam"
          }
        }
      },
      "additionalProperties": false
    },
    "consoleParam": {
      "type": "object",
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "label": {
          "$ref": "common.schema.json#/$defs/localizedText"
        },
        "type": {
          "enum": [
            "character",
            "text",
            "number",
            "location",
            "choice"
          ]
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "default": {
          "type": "integer"
        },
        "choices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "$ref": "common.schema.json#/$defs/localizedText"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "number"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
